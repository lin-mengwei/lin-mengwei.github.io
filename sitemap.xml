---
layout: none
sitemap: false
---
<?xml version="1.0" encoding="UTF-8"?>
{%- comment -%}
  Generated at build time, no plugin needed. Lists every HTML page and every page of the
  BESTEPS Guide. To keep a page out: `sitemap: false` (or `noindex: true`) in its front matter.
  URLs are written without ".html", the same form the navbar links and canonical tags use.
{%- endcomment %}
{%- assign origin = "https://lin-mengwei.github.io" %}
{%- assign listed = "" %}
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
{%- for p in site.html_pages %}
{%- if p.sitemap == false or p.noindex or p.url contains "/notes/" %}{% continue %}{% endif %}
{%- assign path = p.url | remove: ".html" %}
{%- assign listed = listed | append: "|" | append: path | append: "|" %}
<url><loc>{{ origin }}{{ path }}</loc></url>
{%- endfor %}
{%- for d in site.guide %}
{%- assign key = "|" | append: d.url | append: "|" %}
{%- if d.sitemap == false or d.noindex or listed contains key %}{% continue %}{% endif %}
<url><loc>{{ origin }}{{ d.url }}</loc></url>
{%- endfor %}
</urlset>
